rules_version = '2';
// Regras do Firestore (lb-gestao-clientes) — cópia de referência. Quem publica é o Lincoln no console.
// 12/10/2026: financeiro da LB, RH (salários) e gastos pessoais deixam de ser legíveis pela equipe toda.
service cloud.firestore {
  match /databases/{database}/documents {
    function equipe() {
      return request.auth != null && request.auth.token.email in [
        'lincoln@lbmarketplace.com.br',
        'guilherme@lbmarketplace.com.br',
        'caroline@lbmarketplace.com.br',
        'mirela@lbmarketplace.com.br',
        'felipesoares@potencialmidia.com'
      ];
    }
    function diretoria() {
      return request.auth != null && request.auth.token.email in ['lincoln@lbmarketplace.com.br', 'caroline@lbmarketplace.com.br'];
    }
    // Vendedores (21/10/2026): Guilherme (closer do tráfego) e Duda/Akemi (prospecção ativa + orgânico) — cada um só os próprios leads
    function vendedor() {
      return request.auth != null && request.auth.token.email in ['guilherme@lbmarketplace.com.br', 'akemikimidesign@gmail.com'];
    }
    function eu() { return request.auth.token.email; }
    function comercialFreela() {
      return request.auth != null && request.auth.token.email == 'akemikimidesign@gmail.com';
    }
    function soLincoln() {
      return request.auth != null && request.auth.token.email == 'lincoln@lbmarketplace.com.br';
    }

    // Tudo do sistema: equipe — MENOS financeiro, RH e gastos pessoais
    match /{colecao}/{resto=**} {
      allow read, write: if equipe() && !(colecao in ['financeiroLB', 'colaboradoras', 'gastosFixos', 'gastosHistorico', 'lbMarketing', 'crmLeads']);
    }
    // Financeiro da LB e RH: só Lincoln e Carol
    match /financeiroLB/{resto=**} { allow read, write: if diretoria(); }
    match /colaboradoras/{resto=**} { allow read, write: if diretoria(); }
    match /lbMarketing/{resto=**} { allow read, write: if diretoria(); }
    // CRM separado por vendedor (21/10/2026): Lincoln e Carol veem tudo; cada vendedor só lê/edita os leads em que é o dono
    // e não troca o dono (quem troca é a diretoria). Robôs/webhooks usam a conta de serviço (não passam por aqui).
    match /crmLeads/{id} {
      allow read: if diretoria() || (vendedor() && resource.data.donoEmail == eu());
      allow create: if diretoria() || (vendedor() && request.resource.data.donoEmail == eu());
      allow update: if diretoria() || (vendedor() && resource.data.donoEmail == eu() && request.resource.data.donoEmail == eu());
      allow delete: if diretoria();
    }
    // Duda/Akemi (freela, fora da equipe): painel comercial e o histórico das ações dela no CRM
    match /comercialBoard/{resto=**} { allow read, write: if comercialFreela(); }
    match /comercialDiario/{resto=**} { allow read, write: if comercialFreela(); }
    match /historico/{id} { allow create: if comercialFreela(); }
    // Gastos pessoais do Lincoln: só ele
    match /gastosFixos/{resto=**} { allow read, write: if soLincoln(); }
    match /gastosHistorico/{resto=**} { allow read, write: if soLincoln(); }

    // Portal do cliente: Roma Aviamentos lê só o próprio cadastro e só grava a conexão do Mercado Livre
    match /clientes/X6EXAnrhX3J1MCKvt3Mw {
      allow read: if request.auth != null && request.auth.token.email == 'roma@lbmarketplace.com.br';
      allow update: if request.auth != null && request.auth.token.email == 'roma@lbmarketplace.com.br'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mlAccessToken','mlRefreshToken','mlUserId','mlTokenExpiraEm','mlConectadoEm','gmvMlAutomatico','gmvMlAtualizadoEm']);
    }
    // (removido 12/10/2026: acesso do revisor da TikTok — o app já foi aprovado)
  }
}
